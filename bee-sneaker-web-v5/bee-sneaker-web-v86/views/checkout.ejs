<%- include('partials/header') %>
<div class="checkout-grid">
<div class="panel form-panel"><form class="form grid-form" method="post" action="/checkout" id="checkoutForm">
<label>Họ tên khách<input name="customer_name" required></label><label>Số điện thoại<input name="phone" required></label>
<label class="full">Địa chỉ khách hàng<textarea name="address" rows="3" required></textarea></label>
<label>Tỉnh/Thành GHSV<select id="ghsvProvinceCode" name="ghsv_province_code" required><option value="">-- Chọn Tỉnh/Thành --</option></select><input type="hidden" name="ghsv_to_province" id="ghsvProvinceName"></label>
<label>Quận/Huyện GHSV<select id="ghsvDistrictCode" name="ghsv_district_code" required disabled><option value="">-- Chọn Quận/Huyện --</option></select><input type="hidden" name="ghsv_to_district" id="ghsvDistrictName"></label>
<label>Phường/Xã GHSV<select id="ghsvWardCode" name="ghsv_ward_code" required disabled><option value="">-- Chọn Phường/Xã --</option></select><input type="hidden" name="ghsv_to_ward" id="ghsvWardName"></label>
<div class="muted">3 ô này dùng đúng CSDL GHSV để sau khi kho xác nhận, Bee có thể tự tạo vận đơn mà không nhập lại địa chỉ.</div>
<label>Tiền thu hộ tiền hàng<input name="base_cod" id="baseCod" type="number" min="0" value="<%= totals.totalMoney %>" required></label>
<label>Phí ship tự động<input id="shippingFee" value="<%= shippingFee %>" readonly></label>
<label class="full">Cách tính ship<select name="shipping_type" id="shippingType"><option value="freeship">Freeship cho khách</option><option value="customer_pay">Khách trả ship (cộng ship vào COD)</option></select></label>
<div class="full panel" style="padding:16px"><strong>Tạm tính đơn</strong><div style="display:grid;gap:6px;margin-top:8px"><div>Tổng số lượng: <b><%= totals.totalQuantity %> đôi</b></div><div>Tổng tiền gốc: <b><%= Number(totals.totalMoney).toLocaleString('vi-VN') %>đ</b></div><div>COD cuối: <b id="previewCod"></b></div><div>Thuế 1,5%: <b id="previewTax"></b></div><div>Lãi trước ship: <b id="previewProfitBeforeShip"></b></div><div>Phí ship CTV chịu: <b id="previewShipCost"></b></div><div>Lãi CTV cuối: <b id="previewProfit"></b></div></div></div>
<label class="full">Ghi chú<textarea name="note" rows="3"></textarea></label>
<div class="full form-actions"><a class="btn" href="/cart">← Quay lại giỏ</a><button class="btn primary">Đặt đơn</button></div></form></div>
<div class="panel checkout-items"><h3>Sản phẩm trong đơn</h3><p class="muted">Bấm ảnh để xem lớn hoặc Copy ảnh để gửi kho.</p><% cart.forEach((x,idx)=>{ %><div class="checkout-item checkout-item-with-photo-actions"><button type="button" class="thumb checkout-photo-btn" <% if(x.image){ %>onclick="openOrderProductImage('<%= x.image %>')" title="Bấm để xem ảnh lớn"<% } %>><% if(x.image){ %><img src="<%= x.image %>" alt="<%= x.product_name %>"><% } else { %>👟<% } %></button><div><b><%= x.product_name %></b><small><%= variantLabel(x.product_variant) %> · Size <%= x.size %> · SL <%= x.quantity %></small><% if(x.image){ %><div class="checkout-photo-actions"><button type="button" class="btn small" onclick="copyOrderProductImage('<%= x.image %>','<%- String(x.product_name||'Sản phẩm').replace(/'/g, "\\'") %>',this)">📋 Copy ảnh</button><button type="button" class="btn small" onclick="openOrderProductImage('<%= x.image %>')">🔍 Xem</button></div><% } %></div><strong><%= (Number(x.unit_price)*Number(x.quantity)).toLocaleString('vi-VN') %>đ</strong></div><% }) %></div>
</div>
<script>
async function loadGhsvAddressSelects(){
  const p=document.getElementById('ghsvProvinceCode'),d=document.getElementById('ghsvDistrictCode'),w=document.getElementById('ghsvWardCode');
  const pn=document.getElementById('ghsvProvinceName'),dn=document.getElementById('ghsvDistrictName'),wn=document.getElementById('ghsvWardName');
  const fill=(el,rows,placeholder)=>{el.innerHTML=`<option value="">${placeholder}</option>`;for(const x of rows||[]){const o=document.createElement('option');o.value=x.code;o.textContent=x.name;o.dataset.name=x.name;el.appendChild(o)}};
  try{const r=await fetch('/api/ghsv-address/provinces');const j=await r.json();if(!j.success)throw new Error(j.msg||'GHSV');fill(p,j.provinces,'-- Chọn Tỉnh/Thành --')}catch(e){p.innerHTML='<option value="">Không tải được danh sách GHSV</option>'}
  p.addEventListener('change',async()=>{pn.value=p.options[p.selectedIndex]?.dataset?.name||'';dn.value='';wn.value='';d.disabled=true;w.disabled=true;fill(d,[],'Đang tải...');fill(w,[],'-- Chọn Phường/Xã --');if(!p.value)return;try{const r=await fetch('/api/ghsv-address/districts?province_code='+encodeURIComponent(p.value));const j=await r.json();fill(d,j.districts,'-- Chọn Quận/Huyện --');d.disabled=false}catch(e){fill(d,[],'Không tải được Quận/Huyện')}});
  d.addEventListener('change',async()=>{dn.value=d.options[d.selectedIndex]?.dataset?.name||'';wn.value='';w.disabled=true;fill(w,[],'Đang tải...');if(!d.value)return;try{const r=await fetch('/api/ghsv-address/wards?district_code='+encodeURIComponent(d.value));const j=await r.json();fill(w,j.wards,'-- Chọn Phường/Xã --');w.disabled=false}catch(e){fill(w,[],'Không tải được Phường/Xã')}});
  w.addEventListener('change',()=>{wn.value=w.options[w.selectedIndex]?.dataset?.name||''});
}
loadGhsvAddressSelects();
async function copyOrderProductImage(url,name,btn){const old=btn?.textContent;try{const r=await fetch(url,{credentials:'same-origin'});if(!r.ok)throw new Error();const blob=await r.blob();const bitmap=await createImageBitmap(blob);const c=document.createElement('canvas');c.width=bitmap.width;c.height=bitmap.height;c.getContext('2d').drawImage(bitmap,0,0);const png=await new Promise((res,rej)=>c.toBlob(b=>b?res(b):rej(new Error()),'image/png'));if(!navigator.clipboard||!window.ClipboardItem)throw new Error();await navigator.clipboard.write([new ClipboardItem({'image/png':png})]);if(btn){btn.textContent='✅ Đã copy ảnh';setTimeout(()=>btn.textContent=old,1600)}}catch(e){try{await navigator.clipboard.writeText(new URL(url,location.origin).href);if(btn){btn.textContent='🔗 Đã copy link';setTimeout(()=>btn.textContent=old,1600)}}catch(_){openOrderProductImage(url)}}}
function openOrderProductImage(url){window.open(url,'_blank','noopener')}
</script>
<script>(function(){const base=document.getElementById('baseCod'),type=document.getElementById('shippingType'),ship=<%= shippingFee %>,cost=<%= totals.totalMoney %>;const f=n=>Math.round(n||0).toLocaleString('vi-VN')+'đ';function calc(){const b=Math.max(0,Number(base.value)||0),cod=b+(type.value==='customer_pay'?ship:0),tax=Math.round(cod*.015),profit=cod-cost-tax-(type.value==='freeship'?ship:0);document.getElementById('previewCod').textContent=f(cod);document.getElementById('previewTax').textContent=f(tax);document.getElementById('previewShipCost').textContent=f(type.value==='freeship'?ship:0);document.getElementById('previewProfit').textContent=f(profit)}[base,type].forEach(x=>x.addEventListener('input',calc));calc()})();</script>
<%- include('partials/footer') %>