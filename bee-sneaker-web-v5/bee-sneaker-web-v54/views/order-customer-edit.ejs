<%- include('partials/header') %>
<div class="panel form-panel">
  <div class="panel-head">
    <div>
      <h2>Sửa thông tin khách hàng</h2>
      <p class="muted">Đơn #<%= order.id %> · <%= order.product_name %><%= order.product_variant ? ' · '+variantLabel(order.product_variant) : '' %> · Size <%= order.size %></p>
    </div>
    <a class="btn" href="/my-orders">Quay lại đơn của tôi</a>
  </div>

  <form method="post" action="/my-orders/<%= order.id %>/edit-customer" class="form-grid">
    <label class="full">Tên khách hàng
      <input name="customer_name" maxlength="150" required value="<%= order.customer_name %>">
    </label>
    <label>Số điện thoại
      <input name="phone" maxlength="30" required value="<%= order.phone %>">
    </label>
    <label class="full">Địa chỉ khách hàng
      <textarea name="address" maxlength="1000" required rows="4"><%= order.address %></textarea>
    </label>
    <label class="full">Ghi chú
      <textarea name="note" maxlength="2000" rows="4"><%= order.note || '' %></textarea>
    </label>
    <div class="full form-actions">
      <a class="btn" href="/my-orders">Hủy</a>
      <button class="btn primary" type="submit">Lưu thông tin khách hàng</button>
    </div>
  </form>

  <div class="notice info" style="margin-top:16px">
    CTV chỉ có thể sửa thông tin khách hàng của đơn do chính mình tạo. Sản phẩm, phân loại, size, số lượng, COD và lãi không bị thay đổi ở màn hình này.
  </div>
</div>
<%- include('partials/footer') %>
