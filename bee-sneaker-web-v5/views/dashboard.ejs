<%- include('partials/header') %>
<div class="stats"><div class="stat"><span>Sản phẩm</span><strong><%= stats.products %></strong></div><div class="stat"><span>Tổng tồn kho</span><strong><%= stats.quantity %></strong></div><div class="stat"><span>Giá trị kho</span><strong><%= Number(stats.value).toLocaleString('vi-VN') %>đ</strong></div><div class="stat"><span>Tài khoản</span><strong><%= stats.users %></strong></div></div>
<div class="panel"><div class="panel-head"><h2>Sản phẩm mới nhất</h2><a class="btn" href="/products">Xem tất cả</a></div><div class="table-wrap"><table><thead><tr><th>Ảnh</th><th>Tên</th><th>Mã</th><th>Giá</th><th>Size</th><th>Tồn</th></tr></thead><tbody><% latest.forEach(p=>{ %><tr><td><div class="thumb"><% if(p.image){ %><img src="<%= p.image %>"><% } else { %>👟<% } %></div></td><td><b><%= p.name %></b></td><td><%= p.sku || '-' %></td><td><%= Number(p.price).toLocaleString('vi-VN') %>đ</td><td><%= p.size || '-' %></td><td><%= p.quantity %></td></tr><% }) %></tbody></table></div></div>
<%- include('partials/footer') %>
