<%- include('partials/header') %><div class="panel"><div class="table-wrap"><table><thead><tr><th>Mã</th><% if(adminView){ %><th>CTV</th><% } %><th>Khách hàng</th><th>Địa chỉ</th><th>Sản phẩm</th><th>SL</th><th>COD</th><th>Trạng thái</th></tr></thead><tbody><% if(!orders.length){ %><tr><td colspan="9" class="empty">Chưa có đơn hàng.</td></tr><% } %><% orders.forEach(o=>{ %><tr><td>#<%= o.id %><small><%= new Date(o.created_at).toLocaleString('vi-VN') %></small></td><% if(adminView){ %><td><%= o.ctv_name %></td><% } %><td><b><%= o.customer_name %></b><small><%= o.phone %></small></td><td><%= o.address %></td><td><b><%= o.product_name %></b><small>Size <%= o.size %></small></td><td><%= o.quantity %></td><td><b><%= Number(o.cod).toLocaleString('vi-VN') %>đ</b></td><td><% if(adminView){ %><form action="/orders/<%= o.id %>/status" method="post"><select name="status" onchange="this.form.submit()"><% ['Mới','Đã xác nhận','Đang giao','Hoàn thành','Hủy'].forEach(s=>{ %><option <%= o.status===s?'selected':'' %>><%= s %></option><% }) %></select></form><% } else { %><span class="badge"><%= o.status %></span><% } %></td></tr><% }) %></tbody></table></div></div><%- include('partials/footer') %>
