<%- include('partials/header') %><div class="stats ctv-stats"><div class="stat"><span>Đơn của tôi</span><strong><%= stats.orders %></strong></div><div class="stat"><span>Tổng COD đã lên</span><strong><%= Number(stats.revenue).toLocaleString('vi-VN') %>đ</strong></div></div><div class="toolbar"><a class="btn primary" href="/orders/new">+ Tạo đơn mới</a></div><div class="panel"><h2>Đơn gần đây</h2><div class="table-wrap"><table><thead><tr><th>Mã</th><th>Khách</th><th>Sản phẩm</th><th>COD</th><th>Trạng thái</th></tr></thead><tbody><% latest.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><b><%= o.customer_name %></b><small><%= o.phone %></small></td><td><%= o.product_name %> - <%= o.size %></td><td><%= Number(o.cod).toLocaleString('vi-VN') %>đ</td><td><span class="badge"><%= o.status %></span></td></tr><% }) %></tbody></table></div></div><%- include('partials/footer') %>
