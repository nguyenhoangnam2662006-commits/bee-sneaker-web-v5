<%- include('partials/header') %><div class="panel form-panel"><form class="form grid-form" method="post" action="/orders"><label>Họ tên khách<input name="customer_name" required></label><label>Số điện thoại<input name="phone" required></label><label class="full">Địa chỉ khách hàng<textarea name="address" rows="3" required></textarea></label><label>Sản phẩm<select name="product_id" required><option value="">-- Chọn đôi giày --</option><% products.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %> | <%= p.sku||'' %> | <%= Number(p.price).toLocaleString('vi-VN') %>đ</option><% }) %></select></label><label>Size<input name="size" placeholder="Ví dụ: 40" required></label><label>Số lượng<input name="quantity" type="number" min="1" value="1" required></label><label>Thu COD<input name="cod" type="number" min="0" placeholder="Ví dụ: 450000" required></label><label class="full">Ghi chú<textarea name="note" rows="3" placeholder="Màu, yêu cầu khách, ghi chú giao hàng..."></textarea></label><div class="full form-actions"><a class="btn" href="/my-orders">Hủy</a><button class="btn primary">Tạo đơn</button></div></form></div><%- include('partials/footer') %>
