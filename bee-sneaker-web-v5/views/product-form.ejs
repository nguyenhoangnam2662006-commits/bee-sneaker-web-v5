<%- include('partials/header') %>
<div class="panel form-panel"><form action="<%= product ? '/products/'+product.id : '/products' %>" method="post" enctype="multipart/form-data" class="form grid-form"><label class="full">Tên sản phẩm<input name="name" value="<%= product?.name || '' %>" required></label><label>Mã sản phẩm (SKU)<input name="sku" value="<%= product?.sku || '' %>"></label><label>Giá bán (VNĐ)<input type="number" min="0" name="price" value="<%= product?.price || 0 %>" required></label><label>Size<input name="size" value="<%= product?.size || '' %>" placeholder="Ví dụ: 38, 39, 40, 41"></label><label>Số lượng tồn<input type="number" min="0" name="quantity" value="<%= product?.quantity || 0 %>" required></label><label class="full">Ảnh sản phẩm<input type="file" name="image" accept="image/*"></label><% if(product?.image){ %><div class="full preview"><img src="<%= product.image %>"></div><% } %><label class="full">Ghi chú<textarea name="note" rows="4"><%= product?.note || '' %></textarea></label><div class="full form-actions"><a href="/products" class="btn">Quay lại</a><button class="btn primary"><%= product ? 'Lưu thay đổi' : 'Thêm sản phẩm' %></button></div></form></div>
<%- include('partials/footer') %>
