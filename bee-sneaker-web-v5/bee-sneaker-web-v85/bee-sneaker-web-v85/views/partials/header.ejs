<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | Bee Sneaker</title><link rel="stylesheet" href="/style.css"></head><body><% if(user){ %><div class="layout"><aside class="sidebar"><div class="brand">🐝 Bee Sneaker</div><div class="who"><strong><%= user.full_name %></strong><span><%= user.role==='admin'?'Chủ shop':'CTV' %></span></div><nav><a href="/dashboard">📊 <%= user.role==='admin'?'Tổng quan':'Trang CTV' %></a><a href="/products">👟 Sản phẩm</a><% if(user.role==='admin'){ %><a href="/warehouses">🏬 Kho & ưu tiên</a><% } %><a href="/ghsv-lookup">🔎 Tra GHSV</a><% if(user.role==='admin'){ %><a href="/orders">📦 Đơn hàng<% if(adminBadges&&adminBadges.newOrders>0){ %><span class="nav-badge"><%= adminBadges.newOrders>99?'99+':adminBadges.newOrders %></span><% } %></a><a href="/ctv">🤝 CTV<% if(adminBadges&&adminBadges.pendingCtv>0){ %><span class="nav-badge"><%= adminBadges.pendingCtv>99?'99+':adminBadges.pendingCtv %></span><% } %></a><a href="/revenue">💰 Doanh thu</a><a href="/debt">💳 Công nợ CTV Drop</a><a href="/users">👥 Quản lý tài khoản<% if(adminBadges&&adminBadges.pendingCtv>0){ %><span class="nav-dot" title="Có CTV chờ duyệt"></span><% } %></a><a href="/support">🎧 CSKH<% if(adminBadges&&adminBadges.newSupport>0){ %><span class="nav-badge"><%= adminBadges.newSupport>99?'99+':adminBadges.newSupport %></span><% } %></a><a href="/audit">🛡️ Nhật ký bảo mật</a><a href="/products/new">➕ Thêm sản phẩm</a><% } else { %><a href="/cart">🛒 Giỏ hàng (<%= cartCount %>)</a><a href="/my-orders">📦 Đơn của tôi<% if(ctvBadges&&ctvBadges.stockUpdates>0){ %><span class="nav-badge"><%= ctvBadges.stockUpdates>99?'99+':ctvBadges.stockUpdates %></span><% } %></a><a href="/support">🎧 CSKH</a><% } %><a href="/change-password">🔑 Đổi mật khẩu</a></nav><form action="/logout" method="post"><button class="logout">Đăng xuất</button></form></aside><main class="main"><header class="topbar"><h1><%= title %></h1></header><div class="content"><% if(message){ %><div class="alert <%= message.type %>"><%= message.text %></div><% } %><% } %>
