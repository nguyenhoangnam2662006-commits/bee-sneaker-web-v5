<%- include('partials/header') %><div class="stats"><div class="stat"><span>Sản phẩm</span><strong><%= stats.products %></strong></div><div class="stat"><span>Đơn hàng</span><strong><%= stats.orders %></strong></div><div class="stat"><span>CTV</span><strong><%= stats.ctvs %></strong></div><div class="stat"><span>Tổng COD</span><strong><%= Number(stats.revenue).toLocaleString('vi-VN') %>đ</strong></div><div class="stat"><span>Tổng lãi CTV</span><strong><%= Number(stats.ctv_profit).toLocaleString('vi-VN') %>đ</strong></div></div><div class="panel"><div class="panel-head"><h2>Đơn mới nhất</h2><a class="btn" href="/orders">Xem tất cả</a></div><div class="table-wrap"><table><thead><tr><th>Mã</th><th>CTV</th><th>Khách</th><th>Sản phẩm</th><th>COD</th><th>Lãi CTV</th><th>Mã vận đơn</th><th>Trạng thái</th></tr></thead><tbody><% latest.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><%= o.ctv_name %></td><td><b><%= o.customer_name %></b><small><%= o.phone %></small></td><td><%= o.product_name %><%= o.product_variant ? ' · '+o.product_variant : '' %> - <%= o.size %></td><td><b><%= Number(o.cod).toLocaleString('vi-VN') %>đ</b></td><td><%= Number(o.ctv_profit||0).toLocaleString('vi-VN') %>đ</td><td><%= o.tracking_code||'Chưa có' %></td><td><span class="badge"><%= o.status %></span></td></tr><% }) %></tbody></table></div></div><%- include('partials/footer') %>