<%- include('partials/header') %><div class="stats"><div class="stat"><span>Tổng COD toàn hệ thống</span><strong><%= Number(total).toLocaleString('vi-VN') %>đ</strong></div><div class="stat"><span>Tổng lãi CTV</span><strong><%= Number(rows.reduce((s,r)=>s+Number(r.profit||0),0)).toLocaleString('vi-VN') %>đ</strong></div></div><div class="panel"><h2>Doanh thu theo CTV</h2><div class="table-wrap"><table><thead><tr><th>CTV</th><th>Số đơn</th><th>Tổng COD</th><th>Tổng lãi CTV</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><b><%= r.full_name %></b><small><%= r.username %></small></td><td><%= r.orders %></td><td><b><%= Number(r.revenue).toLocaleString('vi-VN') %>đ</b></td><td><b><%= Number(r.profit||0).toLocaleString('vi-VN') %>đ</b></td></tr><% }) %></tbody></table></div></div><%- include('partials/footer') %>