<%- include('partials/header') %><div class="panel"><div class="table-wrap"><table><thead><tr><th>CTV</th><th>Tài khoản</th><th>Tổng đơn</th><th>Đơn hoàn</th><th>Tổng COD</th><th>Lãi thực nhận</th><th></th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td><b><%= r.full_name %></b></td><td><%= r.username %></td><td><%= r.total_orders %></td><td><%= r.returned_orders %></td><td><b><%= Number(r.revenue).toLocaleString('vi-VN') %>đ</b></td><td><b><%= Number(r.profit).toLocaleString('vi-VN') %>đ</b></td><td><a class="btn small" href="/ctv/<%= r.id %>/revenue">Chi tiết</a></td></tr><% }) %></tbody></table></div></div><%- include('partials/footer') %>