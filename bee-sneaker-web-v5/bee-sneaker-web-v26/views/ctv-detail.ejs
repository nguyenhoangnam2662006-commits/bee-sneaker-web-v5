<%- include('partials/header') %>
<div class="panel"><div class="panel-head"><div><h2><%= user.full_name %></h2><p>SĐT đối soát: <b><%= user.phone || user.username %></b></p></div><form method="post" action="/ctv/<%= user.id %>/settle-all" onsubmit="return confirm('Đánh dấu tất cả đơn Hoàn thành/Hoàn đang chờ là đã trả cho CTV này?')"><button class="btn primary" <%= summary.unpaid_orders===0?'disabled':'' %>>✓ Đã trả tất cả (<%= summary.unpaid_orders %> đơn)</button></form></div>
<div class="stats"><div class="stat"><span>Tổng đơn</span><strong><%= summary.total_orders %></strong></div><div class="stat"><span>Hoàn thành</span><strong><%= summary.completed_orders %></strong></div><div class="stat"><span>Đơn hoàn</span><strong><%= summary.returned_orders %></strong></div><div class="stat"><span>Đơn hủy</span><strong><%= summary.cancelled_orders %></strong></div><div class="stat"><span>Chưa thanh toán</span><strong><%= Number(summary.unpaid_profit).toLocaleString('vi-VN') %>đ</strong><small><%= summary.unpaid_orders %> đơn</small></div><div class="stat"><span>Đã thanh toán</span><strong><%= Number(summary.paid_profit).toLocaleString('vi-VN') %>đ</strong><small><%= summary.paid_orders %> đơn</small></div><div class="stat"><span>Lãi đối soát toàn bộ</span><strong><%= Number(summary.profit).toLocaleString('vi-VN') %>đ</strong></div></div></div>
<div class="panel"><h2>Từng đơn của CTV</h2><form method="post" action="/ctv/<%= user.id %>/settle-selected"><div class="table-wrap"><table><thead><tr><th>Chọn</th><th>Mã</th><th>Khách</th><th>Sản phẩm</th><th>COD</th><th>Trạng thái</th><th>Lãi đối soát</th><th>Thanh toán CTV</th></tr></thead><tbody>
<% if(!orders.length){ %><tr><td colspan="8" class="empty">CTV chưa có đơn.</td></tr><% } %>
<% orders.forEach(o=>{ const rec=Number(o.reconciled_profit||0); const eligible=['Hoàn thành','Hoàn'].includes(o.status); %><tr class="<%= o.status==='Hoàn'?'return-row':(o.status==='Hủy'?'cancel-row':'') %>"><td><% if(eligible && !o.ctv_paid){ %><input type="checkbox" name="order_ids" value="<%= o.id %>"><% } %></td><td>#<%= o.id %><small><%= new Date(o.created_at).toLocaleString('vi-VN') %></small></td><td><b><%= o.customer_name %></b><small><%= o.phone %></small></td><td><b><%= o.product_name %></b><% if(o.items&&o.items.length){o.items.forEach(it=>{ %><small>• <%= it.product_name %> · <%= variantLabel(it.product_variant) %> · <%= it.size %> × <%= it.quantity %></small><% })} %></td><td><%= Number(o.cod||0).toLocaleString('vi-VN') %>đ</td><td><span class="badge"><%= o.status %></span></td><td><b class="<%= rec<0?'danger-text':'' %>"><%= rec.toLocaleString('vi-VN') %>đ</b><% if(o.status==='Hoàn'){ %><small>Phí hoàn -45.000đ</small><% } else if(o.status==='Hủy'){ %><small>Không tính lãi</small><% } %></td><td><% if(o.ctv_paid){ %><span class="badge paid">Đã trả</span><small><%= o.ctv_paid_at ? new Date(o.ctv_paid_at).toLocaleString('vi-VN') : '' %></small><small><%= o.settlement_code || '' %></small><% } else if(eligible){ %><span class="badge unpaid">Chưa trả</span><% } else { %><small>Chưa đủ điều kiện</small><% } %></td></tr><% }) %>
</tbody></table></div><div style="margin-top:16px"><button class="btn primary" <%= summary.unpaid_orders===0?'disabled':'' %>>Đánh dấu đã trả các đơn đã chọn</button></div></form></div><%- include('partials/footer') %>
