<%- include('partials/header') %>
<div class="two-col"><div class="panel"><h2>Tạo tài khoản</h2><form action="/users" method="post" class="form"><label>Họ tên<input name="full_name" required></label><label>Tên đăng nhập<input name="username" required></label><label>Mật khẩu<input type="password" name="password" minlength="6" required></label><label>Quyền<select name="role"><option value="staff">Nhân viên</option><option value="admin">Quản trị viên</option></select></label><button class="btn primary">Tạo tài khoản</button></form></div><div class="panel"><h2>Danh sách tài khoản</h2><div class="table-wrap"><table><thead><tr><th>Họ tên</th><th>Tài khoản</th><th>Quyền</th><th></th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><%= u.full_name %></td><td><b><%= u.username %></b></td><td><span class="badge"><%= u.role==='admin'?'Admin':'Staff' %></span></td><td><% if(u.id!==user.id){ %><form action="/users/<%= u.id %>/delete" method="post" onsubmit="return confirm('Xóa tài khoản này?')"><button class="btn danger small">Xóa</button></form><% } %></td></tr><% }) %></tbody></table></div></div></div>
<%- include('partials/footer') %>
