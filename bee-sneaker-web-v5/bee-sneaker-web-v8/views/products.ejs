<%- include('partials/header') %>
<div class="toolbar"><form class="search"><input name="q" value="<%= q %>" placeholder="Tìm tên, mã, size..."><button class="btn">Tìm</button></form><% if(user.role==='admin'){ %><a href="/products/new" class="btn primary">+ Thêm sản phẩm</a><% } %></div>
<div class="panel"><div class="table-wrap"><table><thead><tr><th>Ảnh</th><th>Tên giày</th><th>Mã</th><th>Giá</th><th>Size</th><th>Số lượng</th><th></th></tr></thead><tbody><% if(products.length===0){ %><tr><td colspan="7" class="empty">Không có sản phẩm.</td></tr><% } %><% products.forEach(p=>{ %><tr><td><div class="thumb"><% if(p.image){ %><img src="<%= p.image %>"><% } else { %>👟<% } %></div></td><td><b><%= p.name %></b><% if(p.note){ %><small><%= p.note %></small><% } %></td><td><%= p.sku || '-' %></td><td><%= Number(p.price).toLocaleString('vi-VN') %>đ</td><td><%= p.size || '-' %></td><td><span class="stock <%= p.quantity <= 3 ? 'low' : '' %>"><%= p.quantity %></span></td><td class="actions"><% if(user.role==='admin'){ %><a class="btn small" href="/products/<%= p.id %>/edit">Sửa</a><form action="/products/<%= p.id %>/delete" method="post" onsubmit="return confirm('Xóa sản phẩm này?')"><button class="btn danger small">Xóa</button></form><% } %></td></tr><% }) %></tbody></table></div></div>
<%- include('partials/footer') %>
