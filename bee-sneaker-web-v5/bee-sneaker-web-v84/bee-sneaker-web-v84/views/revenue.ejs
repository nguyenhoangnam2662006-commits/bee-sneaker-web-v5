<%- include('partials/header') %>
<div class="stats"><div class="stat"><span>Tổng COD đang tính</span><strong><%= Number(total).toLocaleString('vi-VN') %>đ</strong></div><div class="stat"><span>Tổng lãi thực nhận CTV</span><strong><%= Number(rows.reduce((s,r)=>s+Number(r.profit||0),0)).toLocaleString('vi-VN') %>đ</strong></div></div>
<div class="panel"><div class="panel-head"><div><h2>Đối soát theo CTV</h2><p>Đơn hoàn: CTV tự bắn trên tài khoản GHSV riêng của họ trừ 20.000đ; CTV chỉ gửi thông tin để shop/Bee lên đơn trừ 45.000đ.</p></div></div><div class="table-wrap"><table><thead><tr><th>CTV</th><th>SĐT</th><th>Tổng đơn</th><th>Hoàn thành</th><th>Đơn hoàn</th><th>Hủy</th><th>Tổng COD</th><th>Lãi bán hàng</th><th>Phí hoàn</th><th>Lãi thực nhận</th><th></th></tr></thead><tbody>
<% rows.forEach(r=>{ %><tr><td><b><%= r.full_name %></b><small><%= r.username %></small></td><td><b><%= r.phone || r.username %></b></td><td><%= r.total_orders %></td><td><%= r.completed_orders %></td><td><%= r.returned_orders %></td><td><%= r.cancelled_orders %></td><td><b><%= Number(r.revenue).toLocaleString('vi-VN') %>đ</b></td><td><%= Number(r.sales_profit).toLocaleString('vi-VN') %>đ</td><td class="danger-text">-<%= Number(r.return_fee).toLocaleString('vi-VN') %>đ</td><td><b><%= Number(r.profit).toLocaleString('vi-VN') %>đ</b></td><td><a class="btn small" href="/ctv/<%= r.id %>/revenue">Xem từng đơn</a></td></tr><% }) %>
</tbody></table></div></div><%- include('partials/footer') %>
