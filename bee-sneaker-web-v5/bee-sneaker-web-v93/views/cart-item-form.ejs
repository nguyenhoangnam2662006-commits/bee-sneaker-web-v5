<%- include('partials/header') %>
<% const vp=product.variant_prices||{}; const soldOut = sizeOptions.length ? sizeOptions.every(x=>Number(x.stock)<=0) : Number(product.quantity||0)<=0; %>
<div class="panel form-panel">
<div class="cart-product-head">
  <div class="order-product-photo-wrap">
    <button type="button" class="thumb cart-large-thumb order-product-photo" <% if(product.image){ %>onclick="openOrderProductImage('<%= product.image %>')" title="Bấm để xem ảnh lớn"<% } %>><% if(product.image){ %><img src="<%= product.image %>" alt="<%= product.name %>"><% } else { %>👟<% } %></button>
    <% if(product.image){ %>
      <div class="order-photo-actions">
        <button type="button" class="btn small" onclick="copyOrderProductImage('<%= product.image %>','<%- String(product.name||'Sản phẩm').replace(/'/g, "\\'") %>', this)">📋 Copy ảnh</button>
        <button type="button" class="btn small" onclick="openOrderProductImage('<%= product.image %>')">🔍 Xem lớn</button>
      </div>
    <% } %>
  </div>
  <div><h2><%= product.name %></h2><div>Mã: <b><%= product.sku||'-' %></b></div><div>Trạng thái: <b><%= soldOut ? 'Hết hàng' : 'Còn hàng' %></b></div><small class="muted">Ảnh này có thể copy để gửi kho khi check hàng.</small></div>
</div>
<% if(soldOut){ %>
  <div class="alert error" role="alert">🔔 Mẫu này đã hết hàng toàn bộ size. Vui lòng chọn mẫu khác.</div>
  <a class="btn" href="/products">← Quay lại sản phẩm</a>
<% } else { %>
<form method="post" action="/cart/add" class="form grid-form">
<input type="hidden" name="product_id" value="<%= product.id %>">
<label>Phân loại hàng<select name="product_variant" required><option value="">-- Chọn phân loại --</option><% ['Like Auth','Siêu Cấp','Best'].forEach(v=>{ if(Number(vp[v]||0)>0){ %><option value="<%= v %>"><%= variantLabel(v) %> - <%= Number(vp[v]).toLocaleString('vi-VN') %>đ</option><% } }) %></select></label>
<% if(sizeOptions.some(x=>x.legacy)){ %><div class="full alert warning">Sản phẩm này đang dùng tồn kho chung từ dữ liệu cũ. Chủ shop nên vào Sửa sản phẩm và nhập tồn riêng cho từng size.</div><% } %><label>Size<select name="size" required><option value="">-- Chọn size --</option><% sizeOptions.forEach(x=>{ %><option value="<%= x.size %>" <%= Number(x.stock)<=0?'disabled':'' %>><%= x.size %> — <%= Number(x.stock)>0 ? 'Còn hàng' : 'Hết size' %></option><% }) %></select></label>
<label>Số lượng<input name="quantity" type="number" min="1" max="20" value="1" required></label>
<div class="full form-actions"><a class="btn" href="/products">Quay lại</a><button class="btn primary">🛒 Thêm vào giỏ</button></div>
</form>
<% } %>
</div>

<script>
async function copyOrderProductImage(url,name,btn){
  const old=btn?.textContent;
  try{
    const r=await fetch(url,{credentials:'same-origin'});
    if(!r.ok) throw new Error('Không tải được ảnh');
    const blob=await r.blob();
    const bitmap=await createImageBitmap(blob);
    const canvas=document.createElement('canvas');
    canvas.width=bitmap.width; canvas.height=bitmap.height;
    canvas.getContext('2d').drawImage(bitmap,0,0);
    const png=await new Promise((resolve,reject)=>canvas.toBlob(b=>b?resolve(b):reject(new Error('Không đổi được ảnh')),'image/png'));
    if(navigator.clipboard && window.ClipboardItem){
      await navigator.clipboard.write([new ClipboardItem({'image/png':png})]);
      if(btn){btn.textContent='✅ Đã copy ảnh'; setTimeout(()=>btn.textContent=old,1600);}
      return;
    }
    throw new Error('Trình duyệt chưa hỗ trợ copy ảnh');
  }catch(e){
    try{ await navigator.clipboard.writeText(new URL(url,location.origin).href); if(btn){btn.textContent='🔗 Đã copy link ảnh';setTimeout(()=>btn.textContent=old,1600);} }
    catch(_){ openOrderProductImage(url); }
  }
}
function openOrderProductImage(url){ window.open(url,'_blank','noopener'); }
</script>
<%- include('partials/footer') %>
